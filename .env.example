# EVIDIQ Envelope MCP — environment template.
# Copy to .env (or the VPS env file) and fill in. Never commit real values.

# --- server ---
PORT=3020
HOSTNAME=0.0.0.0
PUBLIC_BASE_URL=https://mcp.evidiq.dev/envelope

# --- signer (no fallback; unset -> signing tools refuse) ---
# Bare 64-hex or 0x-prefixed 32-byte private key. Derives the fleet signer.
ENVELOPE_SIGNER_PRIVATE_KEY=

# --- store ---
ENVELOPE_DB_PATH=/data/envelope.db

# --- dns ---
# Optional explicit DNS resolver addresses (comma-separated). Unset -> system defaults.
ENVELOPE_DNS_RESOLVERS=

# --- x402 ---
# Phase 1: 1 bypasses the gate (paid tools answer 200). Phase 2: delete the line.
X402_BYPASS=1
X402_PAY_TO=
OKX_BASE_URL=https://www.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# --- 0G Storage anchoring (best effort — attest_message_verdict) ---
# Failures never fail the paid result; anchoring.status reports the real upload outcome.
OG_PRIVATE_KEY=
OG_STORAGE_RPC=https://evmrpc.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-turbo.0g.ai
OG_CHAIN_ID=16661
OG_COMPUTE_RPC=https://evmrpc.0g.ai

# --- node ---
NODE_ENV=production
